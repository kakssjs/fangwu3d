# MiMo API（赛题发放额度）
MIMO_BASE_URL=https://api.mimo.example.com/v1
MIMO_API_KEY=

# DeepSeek API（备用大模型：MiMo 报错/额度用尽时自动兜底，配在 apps/web/.env.local）
DEEPSEEK_API_KEY=
# 可选覆盖：DEEPSEEK_BASE_URL（默认 https://api.deepseek.com）、DEEPSEEK_MODEL（默认 deepseek-flash，支持看图）
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=

# 基础设施
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://user:pass@localhost:5432/irenovation

# 阿里云 OSS
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 登录（apps/web/.env.local）：会话签名密钥（至少 32 个字符）与老板账号
SESSION_SECRET=
BOSS_PHONE=
BOSS_PASSWORD=

# Agnes 图像生成
AGNES_API_KEY=

# HTTP 部署设为 false；HTTPS 部署设为 true
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://39.105.92.190
